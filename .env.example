# KNOOVIQ Attendance Production Environment Template
# Copy this file to .env and fill in real values before starting.

PORT=8086
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_SCHEMA=public
CORS_ORIGIN=https://your-domain.com
# Render public ingress only. Enable when clients reach this service through Render's Cloudflare ingress,
# with no untrusted services on the Render private network.
# TRUST_RENDER_CLIENT_IP=true
SEED_DEMO_DATA=false

# Direct HTTPS. Use the private key and full certificate chain for the hostname used by devices.
# Leave both unset when an HTTPS reverse proxy handles TLS.
# TLS_KEY_FILE=/path/to/privkey.pem
# TLS_CERT_FILE=/path/to/fullchain.pem
# Set TLS_PORT to keep HTTP on PORT for local development. Omit it for HTTPS on PORT.
# TLS_PORT=8443
# Optional redirect for old HTTP bookmarks using the same Wi-Fi hostname or IP.
# LAN_HTTPS_URL=https://192.168.1.10:8443

# JWT Authentication (set a strong random secret in production)
JWT_SECRET=change-this-to-a-strong-random-jwt-secret
JWT_EXPIRES_IN_SECONDS=86400

# Payroll Bank Account Encryption (32+ char secret; defaults to derived app secret if unset)
# PAYROLL_ENCRYPTION_KEY=

# RazorpayX Payouts (configure for live automatic bank transfers)
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=
# RAZORPAYX_WEBHOOK_SECRET=

# Cashfree Payouts (alternative payment provider)
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_WEBHOOK_SECRET=
# CASHFREE_ENV=PRODUCTION
